{
  "name": "monitor-de-internet",
  "version": "1.2.13",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "npm version patch --no-git-tag-version",
    "generate-release-notes": "node release-notes.js",
    "build": "npm run generate-release-notes && electron-builder --win --publish always --releaseNotesFile=release-notes.txt"
  },
  "repository": "https://github.com/md-dirino/Monitor-de-Internet",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-log": "^5.3.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.monitordeinternet.app",
    "productName": "Monitor de Internet",
    "copyright": "© 2025 Maycon Douglas Dirino Silva",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/app/icon.ico",
      "artifactName": "Instalar - Monitor de Internet 64bits.exe"
    },
    "files": [
      "main.js",
      "index.html",
      "sobre.html",
      "package.json",
      "icon.ico",
      "style.css",
      "script.js",
      "render.js",
      "preload.js",
      "resources/**/*"
    ],
    "publish": [
    {
      "provider": "github",
      "owner": "md-dirino",
      "repo": "Monitor-de-Internet",
      "releaseType": "release"
    }
    ]
  }
}